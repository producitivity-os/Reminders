{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Reminders",
  "version": "0.1.0",
  "identifier": "com.productivity-os.reminders",
  "build": {
    "beforeDevCommand": "yarn dev",
    "devUrl": "http://localhost:1460",
    "beforeBuildCommand": "yarn build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Reminders",
        "width": 760,
        "height": 720,
        "minWidth": 560,
        "minHeight": 480,
        "resizable": true,
        "decorations": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": {
          "x": 14,
          "y": 16
        }
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "iOS": {
      "minimumSystemVersion": "15.0",
      "developmentTeam": "A44TG8C84Y"
    },
    "active": true,
    "targets": [
      "dmg"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
